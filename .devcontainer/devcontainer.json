{
  "image": "mcr.microsoft.com/playwright:v1.44.0-jammy",
  "forwardPorts": [
    6080,
    8000
  ],
  "portsAttributes": {
    "6080": {
      "visibility": "private"
    },
    "8000": {
      "visibility": "public",
      "label": "Garmin MCP",
      "onAutoForward": "silent"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "webPort": "6080"
    },
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "postCreateCommand": "(python3 -m pip --version || python3 get-pip.py) && python3 -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
